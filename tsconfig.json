{
  "compilerOptions": {
    "declaration": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "importHelpers": false,
    "inlineSourceMap": true,
    "inlineSources": false,
    "lib": ["es2021", "dom", "dom.iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "outDir": "./dist",
    "removeComments": false,
    "rootDir": ".",
    "sourceRoot": "./src",
    "strict": true,
    "strictNullChecks": true,
    "target": "es2017",
    "types": ["node"]
  },
  "exclude": ["node_modules", "dist"],
  "include": ["src", "test"]
}
